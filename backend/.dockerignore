# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Secrets — never bake into image ───────────────────────────────────────────
.env
*.env
!.env.example

# ── Test / debug artifacts ────────────────────────────────────────────────────
*.pdf
*.png
# Exclude loose .txt files (debug samples) but keep requirements.txt
*.txt
!requirements.txt
tests/
test_*.py
*_test.py
complete_flow_test.py

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
*.swp
*.swo
Thumbs.db

# ── Git ───────────────────────────────────────────────────────────────────────
.git/
.gitignore

# ── Docs ──────────────────────────────────────────────────────────────────────
README.md
docs/
